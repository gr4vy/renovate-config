{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "packageRules": [
    // Groups
    {
      "description": "Group Python language updates",
      "matchPackageNames": [
        "containerbase/python-prebuild", // Poetry [tool.poetry.dependencies] python
        "python" // requires-python (PEP 621), Dockerfile, etc
      ],
      "groupName": "Python"
    },
    {
      "description": "Group Python dev (PEP 735) minor/patch updates",
      "matchCategories": ["python"],
      "matchDepTypes": ["dependency-groups"],
      "matchJsonata": ["managerData.depGroup = 'dev'"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python dev dependencies"
    },
    {
      "description": "Group Python dev (Poetry) minor/patch updates",
      "matchManagers": ["poetry"],
      // [tool.poetry.group.dev.dependencies]
      "matchDepTypes": ["dev"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Python dev dependencies"
    },
    {
      "description": "Group Python OpenTelemetry updates",
      "matchCategories": ["python"],
      "matchPackageNames": ["opentelemetry-*"],
      "groupName": "Python OpenTelemetry"
    },
    {
      // Contrib packages (e.g. opentelemetry-instrumentation-*) only publish
      // betas, each pinned to one SDK release. Without this, Renovate stays on
      // the current beta (0.66b2 -> 0.67b0 changes the release), so they fall
      // behind the stable packages in the same group.
      "description": "Allow Python OpenTelemetry beta-only packages to update to newer betas",
      "matchCategories": ["python"],
      "matchPackageNames": ["opentelemetry-*"],
      // Only packages already on a prerelease, so stable ones never move to alphas/RCs
      "matchCurrentVersion": "/^\\d+(\\.\\d+)*(a|b|rc)\\d+$/",
      "ignoreUnstable": false
    },

    // Automerge
    {
      "description": "Disable automerge for Python major updates",
      "matchCategories": ["python"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Enable automerge for Python minor stable updates",
      "matchCategories": ["python"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "!/^v?0/", // Excludes 0.x packages, where a minor bump can be breaking
      "automerge": true
    },
    {
      "description": "Enable automerge for Python patch updates",
      "matchCategories": ["python"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Enable automerge for Python dev (PEP 735) minor/patch updates",
      "matchCategories": ["python"],
      "matchDepTypes": ["dependency-groups"],
      "matchJsonata": ["managerData.depGroup = 'dev'"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Enable automerge for Python dev (Poetry) minor/patch updates",
      "matchManagers": ["poetry"],
      // [tool.poetry.group.dev.dependencies]
      "matchDepTypes": ["dev"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },

    // Manually-requested (never auto-merged)
    {
      "description": "Require Dependency Dashboard approval for Python language updates",
      "matchPackageNames": [
        "containerbase/python-prebuild", // Poetry [tool.poetry.dependencies] python
        "python" // requires-python (PEP 621), Dockerfile, etc
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
